{
  "name": "alter",
  "version": "0.1.0",
  "private": true,
  "description": "Alter — your personal AI that runs on the AI subscriptions you already pay for (Claude, ChatGPT, Gemini). Desktop + phone, shared memory, agents that learn your day.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/desktop"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node packages/core/src/cli.ts start",
    "dev": "node --watch packages/core/src/cli.ts start",
    "desktop": "npm run start --workspace @alter/desktop",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test packages/core/test/*.test.ts"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0"
  }
}
